# Reno 10x physical unslotted partitions; no slotselect or logical flags.
/boot emmc /dev/block/bootdevice/by-name/boot flags=backup=1;display="Boot"
/recovery emmc /dev/block/bootdevice/by-name/recovery flags=backup=1;display="Recovery"
/system_root ext4 /dev/block/by-name/system flags=backup=0;display="System";fsflags=ro
/vendor ext4 /dev/block/by-name/vendor flags=backup=0;display="Vendor";fsflags=ro
/metadata ext4 /dev/block/bootdevice/by-name/metadata flags=backup=0;display="Metadata"
/cache ext4 /dev/block/by-name/cache flags=backup=0;display="Cache"
/data ext4 /dev/block/bootdevice/by-name/userdata flags=display="Data"
/firmware vfat /dev/block/bootdevice/by-name/modem flags=mounttodecrypt;fsflags=ro;display="Firmware"
/misc emmc /dev/block/bootdevice/by-name/misc
/usbstorage vfat /dev/block/sdg1 /dev/block/sdg flags=fsflags=utf8;display="USB Storage";storage;removable
